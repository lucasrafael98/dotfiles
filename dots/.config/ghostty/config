env = LESSHISTFILE=-

font-family = Lilex Nerd Font Mono
font-size = 15

cursor-style = underline
cursor-style-blink = true
adjust-cursor-thickness = 1
mouse-hide-while-typing = true
confirm-close-surface = true

background-opacity = 0.8
background-blur = 40
window-padding-x = 4
window-padding-y = 4
macos-option-as-alt = true

# Colors (gruvbox dark hard)
background = #1d2021
foreground = #fbf1c7
cursor-color = #fbf1c7
cursor-text = cell-background
selection-foreground = #928374
selection-background = #ebdbb2
split-divider-color = #665c54

palette = 0=#282828
palette = 8=#7c6f64
palette = 1=#cc241d
palette = 9=#fb4934
palette = 2=#98971a
palette = 10=#b8bb26
palette = 3=#d79921
palette = 11=#fabd2f
palette = 4=#458588
palette = 12=#83a598
palette = 5=#b16286
palette = 13=#d3869b
palette = 6=#689d6a
palette = 14=#8ec07c
palette = 7=#a89984
palette = 15=#fbf1c7

# Leader: ctrl+a
keybind = ctrl+a>x=new_split:down
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>shift+n=previous_tab
keybind = ctrl+a>space=write_scrollback_file:open

# Split navigation. `performable` passes the key through to the program
# (e.g. nvim) when there's no split in that direction.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
